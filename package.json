{
  "name": "agy-wallpaper-glass",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "Wallpaper Engine backgrounds (Scene/Web via bundled WebWallGL, Video, Image), 6 built-in animated wallpapers, bilingual EN/ZH UI, interactive catgirl pet, and iOS-style Liquid Glass styling Sidecar for Antigravity Desktop (Windows & macOS)",
  "homepage": "https://github.com/Prometheus153/agy-wallpaper-glass",
  "repository": {
    "type": "git",
    "url": "https://github.com/Prometheus153/agy-wallpaper-glass.git"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "preview": "node sidecars/glass/server.mjs --preview",
    "test": "node --test tests/*.test.mjs",
    "doctor": "node scripts/doctor.mjs",
    "sync:vendor": "node -e \"import('node:fs').then(fs=>{fs.mkdirSync('sidecars/glass/vendor',{recursive:true});fs.copyFileSync('node_modules/webwallgl/webwallgl.global.min.js','sidecars/glass/vendor/webwallgl.global.min.js');fs.copyFileSync('node_modules/webwallgl/LICENSE','sidecars/glass/vendor/webwallgl.LICENSE');console.log('Synced webwallgl vendor bundle');})\"",
    "pack:release": "node scripts/pack.mjs",
    "install:local": "node scripts/install.mjs",
    "update:local": "node scripts/install.mjs --update",
    "uninstall:local": "node scripts/install.mjs --uninstall"
  },
  "files": [
    "plugin.json",
    "logo.svg",
    "README.md",
    "README.zh-CN.md",
    "sidecars/",
    "scripts/install.mjs",
    "scripts/doctor.mjs",
    "install.bat",
    "install-mac.command",
    "LICENSE"
  ],
  "devDependencies": {
    "webwallgl": "^3.0.3"
  }
}
